<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- GHCP001: Copilot SDK permission types are marked evaluation-only. -->
    <NoWarn>$(NoWarn);MEAI001;GHCP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings GitHub.Copilot.SDK 1.0.14. A direct SDK reference would import its build targets twice (MSB4011). -->
    <PackageReference Include="Microsoft.Agents.AI.GitHub.Copilot" Version="1.28.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Synadia.AI.Agents.AgentFramework\Synadia.AI.Agents.AgentFramework.csproj" />
    <ProjectReference Include="..\..\src\Synadia.AI.Agents.Testing\Synadia.AI.Agents.Testing.csproj" />
  </ItemGroup>

</Project>
