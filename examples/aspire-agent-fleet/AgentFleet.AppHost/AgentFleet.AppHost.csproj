  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\integrations\aspire\src\Synadia.AI.Agents.Hosting.Aspire\Synadia.AI.Agents.Hosting.Aspire.csproj" IsAspireProjectResource="false" />
