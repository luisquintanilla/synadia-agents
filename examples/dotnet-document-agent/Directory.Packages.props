<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Extraction (preview) -->
    <PackageVersion Include="CommunityToolkit.DocumentExtraction.PdfPig" Version="1.0.0-preview" />
    <PackageVersion Include="CommunityToolkit.DocumentExtraction.VisionLanguageModel" Version="1.0.0-preview" />
    <PackageVersion Include="Microsoft.Extensions.DocumentExtraction" Version="11.0.0-preview.1.26560.3" />
    <PackageVersion Include="Microsoft.Extensions.DocumentExtraction.Abstractions" Version="11.0.0-preview.1.26560.3" />
    <PackageVersion Include="Microsoft.Extensions.Documents.Abstractions" Version="11.0.0-preview.1.26560.3" />
    <!-- Ingestion / vector data -->
    <PackageVersion Include="Microsoft.Extensions.DataIngestion" Version="11.0.0-preview.1.26560.3" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="11.0.0" />
    <PackageVersion Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="3.0.0" />
    <!-- AI -->
